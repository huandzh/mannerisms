# Normalize line endings to LF in the repository and every checkout.
* text=auto eol=lf

# Batch files must keep CRLF to run under cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary

# Generated lockfiles are text but are not hand-edited; keep diffs stable.
Cargo.lock text eol=lf
